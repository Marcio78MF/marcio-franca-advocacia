# Jev Decision Layer — copie para .env (NUNCA commite o .env)
# Chave em https://console.typesafe.ai
TYPESAFE_API_KEY=
# Opcional
# TYPESAFE_DEFAULT_MODEL=jev-latest        # ou jev-1.13.0 (versão fixa)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# Alternativa via OpenRouter (endpoint ALPHA de decisions, não chat/completions)
# OPENROUTER_API_KEY=
# OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# JEV_OPENROUTER_MODEL=typesafe/jev-1.13
# Comportamento
# JEV_GUARD=off            # desliga o hook de ferramentas
# JEV_ROUTER_HINT=1        # liga a dica de modelo a cada prompt
# JEV_ROUTER_BASE=ordinary # tier de referência do roteador
# JEV_DEBUG=1              # imprime tokens/latência no stderr
